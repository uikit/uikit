{
    "name": "uikit",
    "title": "UIkit",
    "description": "UIkit is a lightweight and modular front-end framework for developing fast and powerful web interfaces.",
    "version": "3.25.31",
    "main": "dist/js/uikit.js",
    "style": "dist/css/uikit.css",
    "sideEffects": [
        "*.css",
        "./src/js/*.js",
        "./dist/**/*.js"
    ],
    "scripts": {
        "build-scss": "node build/scss",
        "compile": "pnpm compile-less && pnpm compile-js",
        "compile-js": "node build/build",
        "compile-less": "pnpm icons && node build/less",
        "compile-rtl": "pnpm compile-less rtl",
        "icons": "node build/icons",
        "prefix": "node build/prefix",
        "scope": "node build/scope",
        "watch": "node build/watch.js"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/uikit/uikit.git"
    },
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/uikit/uikit/issues"
    },
    "homepage": "https://getuikit.com",
    "packageManager": "pnpm@12.16.1",
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@rollup/plugin-alias": "^6.0.1",
        "archiver": "^8.0.0",
        "camelcase": "^10.0.0",
        "clean-css": "^5.3.3",
        "esbuild": "^0.28.2",
        "eslint": "^10.14.0",
        "eslint-config-prettier": "^10.1.8",
        "execa": "^10.2.1",
        "globals": "^17.14.0",
        "inquirer": "^14.2.5",
        "less": "^4.9.1",
        "minimist": "^1.2.8",
        "p-limit": "^7.3.3",
        "prettier": "^3.9.10",
        "prettier-plugin-organize-imports": "^4.3.0",
        "rollup": "^4.67.4",
        "rollup-plugin-esbuild": "^6.2.1",
        "rtlcss": "^4.3.0",
        "semver": "^7.8.6",
        "strip-css-comments": "^5.0.0",
        "svgo": "^4.1.0"
    }
}
